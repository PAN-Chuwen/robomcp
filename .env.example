# Copy to .env (gitignored) and adjust. Used by docker compose, the platform API, worker and tests.

# --- agent harness (src/robomcp) ---
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# LLM_PROVIDER=
# LLM_MODEL=

# --- docker compose services ---
POSTGRES_USER=robomcp
POSTGRES_PASSWORD=robomcp-dev
POSTGRES_DB=robomcp
POSTGRES_HOST_PORT=5442
MINIO_ROOT_USER=robomcp
MINIO_ROOT_PASSWORD=robomcp-dev-minio
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011

# --- platform (packages/platform) ---
ROBOMCP_DATABASE_URL=postgresql+psycopg://robomcp:robomcp-dev@localhost:5442/robomcp
# Server the integration tests create their throwaway database on (needs CREATEDB).
# Defaults to ROBOMCP_DATABASE_URL; the database name in it is ignored.
# ROBOMCP_TEST_DATABASE_URL=postgresql+psycopg://robomcp:robomcp-dev@localhost:5442/postgres
ROBOMCP_S3_ENDPOINT_URL=http://localhost:9010
ROBOMCP_S3_ACCESS_KEY=robomcp
ROBOMCP_S3_SECRET_KEY=robomcp-dev-minio
ROBOMCP_S3_BUCKET=robomcp
# Worker: seconds between heartbeats, seconds before a running episode counts as stale, attempts before error.
ROBOMCP_HEARTBEAT_INTERVAL_S=5
ROBOMCP_HEARTBEAT_TIMEOUT_S=30
ROBOMCP_MAX_ATTEMPTS=3
# Concurrent episodes per org across all workers (unset: no cap). Claims are fair-share across orgs either way.
# ROBOMCP_MAX_RUNNING_PER_ORG=4
